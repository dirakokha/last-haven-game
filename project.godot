; Target: Godot 4.7.2 Standard
config_version=5

[application]
config/name="آخرین پناهگاه"
run/main_scene="res://scenes/side/Court.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"

[rendering]
renderer/rendering_method="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true

[input]
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68)]
}
move_far={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87)]
}
move_near={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83)]
}
sprint={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194325)]
}
pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}
fire={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":1)]
}
reload={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":82)]
}
bat={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":70)]
}
restart={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194309)]
}

side_jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32)]
}

side_dodge={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194326)]
}

side_entrance={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87)]
}

side_interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
side_inventory={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194306)]
}
side_loot_take={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194309)]
}
weapon_slot_1={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":49)]
}
weapon_slot_2={
"deadzone": 0.2,
